# Route402 environment
# Copy to .env and fill in. Never commit .env.
# MainNet keys stay on the local machine and never enter this repo.

# ── network ──────────────────────────────────────────────
# 'testnet' for all development. 'mainnet' only for the final endpoint.
NETWORK=testnet

# ── ports ────────────────────────────────────────────────
ROUTER_PORT=4000
PROVIDER_ALPHA_PORT=4001
PROVIDER_BETA_PORT=4002
PROVIDER_GAMMA_PORT=4003
DASHBOARD_PORT=5173

# ── provider base URLs (deployment only) ─────────────────
# Leave empty for local dev — the router falls back to http://localhost:<port>.
# Set these to each provider's public URL (e.g. Railway domain) once deployed,
# so the router can reach them from outside localhost.
PROVIDER_ALPHA_URL=
PROVIDER_BETA_URL=
PROVIDER_GAMMA_URL=

# ── ledger ───────────────────────────────────────────────
DB_PATH=./data/route402.db

# ── Algorand node access (Phase 3 — see docs/VERIFY.md) ──
ALGOD_SERVER_TESTNET=
ALGOD_TOKEN=
INDEXER_SERVER_TESTNET=
INDEXER_TOKEN=

# ── x402 (Phase 3 — see docs/VERIFY.md) ──────────────────
# Route402 hosts its own facilitator in-process; this points the providers'
# x402 middleware at it. Not an external URL.
# USDC ASA id and the algorand:* CAIP-2 network id are NOT env-configured —
# @x402/avm ships them as verified constants; see docs/VERIFY.md.
FACILITATOR_URL=
EXPLORER_TX_TEMPLATE=

# ── wallets (Phase 3) ────────────────────────────────────
# Agent holds USDC and only the ALGO dust Algorand requires to exist/opt in
# to an asset (~0.2 ALGO) — zero ALGO is ever spent on transaction fees.
# Sponsor holds ALGO and pays group fees; also signs for the self-hosted facilitator.
AGENT_MNEMONIC=
AGENT_ADDRESS=
SPONSOR_MNEMONIC=
SPONSOR_ADDRESS=

# Provider payout addresses/mnemonics. Start empty of USDC — balance growth is the proof.
PROVIDER_ALPHA_MNEMONIC=
PROVIDER_ALPHA_ADDRESS=
PROVIDER_BETA_MNEMONIC=
PROVIDER_BETA_ADDRESS=
PROVIDER_GAMMA_MNEMONIC=
PROVIDER_GAMMA_ADDRESS=
