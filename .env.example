# Route402 environment
# Copy to .env and fill in. Never commit .env.
# MainNet keys stay on the local machine and never enter this repo.

# ── network ──────────────────────────────────────────────
# 'testnet' for all development. 'mainnet' only for the final endpoint.
NETWORK=testnet

# ── ports ────────────────────────────────────────────────
ROUTER_PORT=4000
PROVIDER_ALPHA_PORT=4001
PROVIDER_BETA_PORT=4002
PROVIDER_GAMMA_PORT=4003
DASHBOARD_PORT=5173

# ── ledger ───────────────────────────────────────────────
DB_PATH=./data/route402.db

# ── Algorand node access (Phase 3) ───────────────────────
ALGOD_SERVER=
ALGOD_PORT=
ALGOD_TOKEN=
INDEXER_SERVER=
INDEXER_PORT=
INDEXER_TOKEN=

# ── x402 facilitator (Phase 3 — see docs/VERIFY.md) ──────
FACILITATOR_URL=
USDC_ASA_ID=
EXPLORER_TX_TEMPLATE=

# ── wallets (Phase 3) ────────────────────────────────────
# Agent holds USDC and deliberately ZERO ALGO — this is what
# proves fee abstraction. Sponsor holds ALGO and pays group fees.
AGENT_MNEMONIC=
SPONSOR_MNEMONIC=

# Provider payout addresses. Start empty — balance growth is the proof.
PROVIDER_ALPHA_ADDRESS=
PROVIDER_BETA_ADDRESS=
PROVIDER_GAMMA_ADDRESS=
